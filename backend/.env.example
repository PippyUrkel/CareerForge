# LLM Configuration (Ollama local endpoint or OpenAI)
# For Ollama:
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=180

# For OpenAI (alternative):
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# YouTube Data API (Optional)
YOUTUBE_API_KEY=

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Cross Encoder Model
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Database
DATABASE_URL=sqlite+aiosqlite:///./careerforge.db

# Redis (optional, for embedding caching)
REDIS_URL=

# Application
DEBUG=false
LOG_LEVEL=INFO

# Appwrite Configuration
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=careerforge_db
APPWRITE_COURSES_COLLECTION_ID=courses
APPWRITE_PROFILES_COLLECTION_ID=profiles
APPWRITE_BUCKET_ID=resumes
